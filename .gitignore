# Unreal Engine / SML mod build output.
# The repo root IS the plugin; CI copies it into the SML starter project's
# Mods/ dir and builds there, so nothing under these paths should be committed.

# Compiled binaries and intermediates
Binaries/
Intermediate/
Build/
DerivedDataCache/
Saved/

# Object / precompiled-header / debug files
*.o
*.obj
*.slo
*.lo
*.gch
*.pch
*.pdb

# Generated project files
*.sln
*.suo
*.xcodeproj
*.xcworkspace
*.VC.db
*.VC.opendb
*.sdf
*.opensdf

# Built map data
*_BuiltData.uasset

# Editor / IDE / OS noise
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db
